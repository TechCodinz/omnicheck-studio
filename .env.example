# OmniCheck Studio — environment template. Copy to .env and fill in real values.
# Never commit a filled-in .env.

# Backend (backend uses SQLite via better-sqlite3 — there is no MongoDB/Redis
# connection in the current code, despite older docs/compose files claiming so)
PORT=3001
NODE_ENV=production

# REQUIRED. The server refuses to start without a strong secret.
# Generate: openssl rand -hex 32
JWT_SECRET=

# The single frontend origin allowed to call the API / sockets.
CORS_ORIGIN=http://localhost:3000

# Optional: hex master key for the encryption service
ENCRYPTION_MASTER_KEY=

# Frontend
REACT_APP_API_URL=http://localhost:3001

# Optional / only if you enable the integrations that use them.
# (Stripe, AWS, SMTP, Plaid etc. are not wired into the current server routes.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
